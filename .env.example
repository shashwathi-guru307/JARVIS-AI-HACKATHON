GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Vision configuration
VISION_MODE=local
VISION_INTERVAL=2
PREDICTION_ENABLED=true
PREDICTION_INTERVAL=5
TELEMETRY_HISTORY_LIMIT=1000
DEMO_SCENARIO=normal
# J.A.R.V.I.S. Environment Configuration # Copy to .env and fill in your values. NEVER commit .env. 
# ── AI ───────────────────────────────────────────────────────────────────── 
OPENAI_API_KEY=your-openai-api-key-here AI_ENABLED=true 
# ── Vision ───────────────────────────────────────────────────────────────── 
VISION_ENABLED=true 
# ── Auth ─────────────────────────────────────────────────────────────────── 
JWT_SECRET=change-this-to-a-long-random-secret JWT_EXPIRATION_MINUTES=60 
# ── Rate limiting ─────────────────────────────────────────────────────────── 
RATE_LIMIT_REQUESTS=60 RATE_LIMIT_WINDOW_SECONDS=60 
# ── Demo ─────────────────────────────────────────────────────────────────── 
DEMO_MODE=true DEMO_SCENARIO=NORMAL 
# ── History limits ────────────────────────────────────────────────────────── 
EVENT_HISTORY_LIMIT=200 ALERT_HISTORY_LIMIT=50 TELEMETRY_HISTORY=60 SYSTEM_UPDATE_INTERVAL=5